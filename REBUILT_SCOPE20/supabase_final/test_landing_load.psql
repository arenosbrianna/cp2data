\set ON_ERROR_STOP on
\copy landing.calendar_ext (date, day_of_week, dow, iso_week, iso_year, week_start_date, month, quarter, year, is_weekend, is_holiday, is_payday, is_ber_month, is_open) from 'datasets/calendar_ext.csv' with (format csv, header true)
\copy landing.ingredient_volume (ingredient_id, ingredient_code, storage_type, base_uom, litres_per_base_unit, provenance) from 'datasets/ingredient_volume.csv' with (format csv, header true)
\copy landing.ingredients (ingredient_id, ingredient_code, ingredient_name, category, storage_type, base_uom, shelf_life_days, is_perishable, standard_unit_cost) from 'datasets/ingredients.csv' with (format csv, header true)
\copy landing.inventory (snapshot_date, ingredient_id, opening_qty, qty_received, qty_emergency, qty_consumed, qty_off_pos_use, closing_qty, reorder_point, order_qty, on_order_qty, stockout_flag, emergency_cost_php, qty_unmet, shortage_cost_php) from 'datasets/inventory.csv' with (format csv, header true)
\copy landing.inventory_batches (snapshot_date, batch_id, ingredient_id, supplier_id, received_date, expiry_date, qty_on_hand, unit_cost) from 'datasets/inventory_batches.csv' with (format csv, header true)
\copy landing.menu_items (item_id, item_name, category, list_price, pos_sku, is_complimentary, is_active) from 'datasets/menu_items.csv' with (format csv, header true)
\copy landing.recipes (item_id, ingredient_id, qty_base, uom) from 'datasets/recipes.csv' with (format csv, header true)
\copy landing.sales (sale_id, sale_date, item_id, channel, quantity_sold, unit_price, gross_sales, discount, net_sales, is_revenue) from 'datasets/sales.csv' with (format csv, header true)
\copy landing.sales_dropped (sale_date, item_id, quantity_sold) from 'datasets/sales_dropped.csv' with (format csv, header true)
\copy landing.stockout_events (event_date, ingredient_id, need_qty, available_qty, shortfall_qty, outcome, emergency_qty, emergency_cost_php, unmet_qty, shortage_cost_php) from 'datasets/stockout_events.csv' with (format csv, header true)
\copy landing.storage_capacity (storage_type, capacity_dedicated_l, shared_pool_l, locations, capacity_total_if_pool_taken_l, rule, provenance, baseline_stock_p95_l, baseline_stock_max_l, baseline_days_above_dedicated) from 'datasets/storage_capacity.csv' with (format csv, header true)
\copy landing.supplier_item_terms (supplier_id, ingredient_id, order_unit, pack_size, pack_unit, pack_size_base, min_order_packs) from 'datasets/supplier_item_terms.csv' with (format csv, header true)
\copy landing.suppliers (supplier_id, supplier_name, lead_time_days, lead_time_sd_days, delivery_interval_days) from 'datasets/suppliers.csv' with (format csv, header true)
\copy landing.waste (waste_id, waste_date, ingredient_id, batch_id, waste_qty, waste_reason, waste_value_php) from 'datasets/waste.csv' with (format csv, header true)
